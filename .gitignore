# Datos (base SQLite, sesiones, fotos subidas, respaldos) — nunca al repositorio
data/
public/uploads/
*.sqlite
*.sqlite-*
*.sqlite3
*.db
*.bak
*.log
respaldos/
*_respaldos/
*.tar.gz

# Secretos y configuración del servidor
app/config.php
public/.user.ini
.env
*.pem
*.key
cuenta_servicio*.json
